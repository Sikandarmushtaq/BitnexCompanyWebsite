# ============================================================
#  Bitnex Technologies LLC — site settings
#  Change a value here, then restart `npm run dev` or rebuild.
#  Used on: Contact, Privacy Policy, Terms & Conditions,
#  SMS Terms pages (and the footer / whole site).
#  Vite only exposes variables that start with VITE_.
# ============================================================

# --- Company ---
# Brand / DBA name customers see (must match your 10DLC brand "DBA or brand name")
VITE_COMPANY_NAME=Bitnex Technologies LLC
# Legal name exactly as on your EIN (must match your 10DLC brand "Legal company name")
VITE_COMPANY_LEGAL_NAME=Bitnex Technologies LLC
VITE_WEBSITE_URL=https://bitnextechnologies.com
VITE_WEBSITE_DOMAIN=bitnextechnologies.com

# --- Contact ---
VITE_SUPPORT_EMAIL=info@bitnextechnologies.com
VITE_COMPLAINTS_EMAIL=complaints@bitnextechnologies.com
VITE_PRIVACY_EMAIL=info@bitnextechnologies.com
# Main phone shown on the site
VITE_PHONE_DISPLAY=(210) 972-5049
VITE_PHONE_E164=+12109725049
# Your Telnyx 10DLC texting number (US). Shown as "text HELP to ...".
# Leave empty until you have it; the site will then show the main phone.
VITE_SMS_NUMBER_DISPLAY=
VITE_SMS_NUMBER_E164=
VITE_BUSINESS_HOURS=Monday to Friday, 9:00 AM to 6:00 PM (EST)

# --- Social media (leave empty to hide an icon) ---
VITE_FACEBOOK_URL=https://www.facebook.com/bitnextechnologies/
VITE_INSTAGRAM_URL=https://www.instagram.com/bitnextechnologies/
VITE_LINKEDIN_URL=https://www.linkedin.com/company/bitnex-technologies/

# --- Offices ---
VITE_PRIMARY_OFFICE_LABEL=Corporate Office
VITE_PRIMARY_OFFICE_ADDRESS=6545 Market Ave N Ste 100, Canton, OH 44721, USA
# Optional second office (leave empty to hide)
VITE_SECONDARY_OFFICE_LABEL=
VITE_SECONDARY_OFFICE_ADDRESS=

# --- Legal ---
VITE_LEGAL_EFFECTIVE_DATE=September 24, 2026
VITE_GOVERNING_LAW_STATE=State of Ohio

# --- SMS program (must match your Telnyx 10DLC campaign) ---
VITE_SMS_PROGRAM_NAME=Bitnex Technologies LLC SMS
# true = show the separate, optional marketing checkbox on the contact form.
# Set to false if your 10DLC campaign does NOT include the Marketing use case.
VITE_SMS_MARKETING_ENABLED=true

# --- Contact form ---
# URL the contact form POSTs JSON to. On cPanel keep /contact.php (included in public/).
# It emails each inquiry and saves the SMS consent record to consent-logs/sms-consent.csv.
VITE_CONTACT_FORM_ENDPOINT=/contact.php
